# GoingElectric API key. Without it the map shows only the Ecurious bays and says why.
# Create a key at https://www.goingelectric.de/stromtankstellen/api/
GOINGELECTRIC_API_KEY=

# Ecurious hackathon server. When both are set, the app drives the team's real locks
# through src/lib/ecurious.ts (REST /api/v1/locks and the /events stream).
ECURIOUS_BASE_URL=
ECURIOUS_API_KEY=

# Optional. If set, the camera endpoint requires header x-device-key.
ECURIOUS_DEVICE_KEY=

# Secret for plate hashes. Change this before any shared deployment.
PLATE_HASH_SALT=replace-me

# Where the Ecurious bays stand and where the map opens (venue: TUM Audimax).
NEXT_PUBLIC_VENUE_LAT=
NEXT_PUBLIC_VENUE_LNG=
NEXT_PUBLIC_VENUE_STREET=
NEXT_PUBLIC_VENUE_POSTCODE=
NEXT_PUBLIC_VENUE_CITY=

# Optional. When set, OCPI partners must send "Authorization: Token <value>" to the OCPI command endpoints.
OCPI_TOKEN=

# Optional. Set before putting the app online: visitors must enter this password (it moves real barriers).
APP_PASSWORD=

# Leave unset or false so reserve, check-in, and release command the locks.
# Set true only to watch live status without sending whitelist, lock, or unlock.
SHOWCASE_MODE=

# Gates the dashboard reset.
OPERATOR_RESET_TOKEN=
